<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>

        <!-- PostgreSQL database connection settings -->
        <property name="hibernate.connection.driver_class">org.postgresql.Driver</property>
        <property name="hibernate.connection.url">jdbc:postgresql://localhost:5432/hospital_db</property>
        <property name="hibernate.connection.username">postgres</property>
        <property name="hibernate.connection.password">123</property>

        <!-- PostgreSQL dialect -->
        <property name="hibernate.dialect">org.hibernate.dialect.PostgreSQLDialect</property>

        <!-- Display executed SQL in console -->
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>

        <!-- Automatically create or update tables -->
        <property name="hibernate.hbm2ddl.auto">create</property>

        <!-- Entity mappings -->
        <mapping class="com.example.Hospital_Management_System.entity.Doctors"/>
        <mapping class="com.example.Hospital_Management_System.entity.Patients"/>
        <mapping class="com.example.Hospital_Management_System.entity.Nurses"/>
        <mapping class="com.example.Hospital_Management_System.entity.Appointments"/>
        <mapping class="com.example.Hospital_Management_System.entity.User"/>
        <mapping class="com.example.Hospital_Management_System.entity.Department"/>

    </session-factory>
</hibernate-configuration>
